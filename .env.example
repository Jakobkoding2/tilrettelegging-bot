# --------------------------------------------
# OAuth / JWT Configuration (for Black Box API)
# --------------------------------------------
# Secret for signing JWT tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-jwt-secret-here-change-me

# JWT token expiration time (e.g., 24h, 7d, 30d)
JWT_EXPIRY=24h

# OAuth token endpoint (for university systems to get access tokens)
OAUTH_TOKEN_ENDPOINT=/v1/auth/token

# --------------------------------------------
# Webhook Configuration (optional - for async notifications)
# --------------------------------------------
# Enable webhook notifications when jobs complete
ENABLE_WEBHOOKS=false

# Webhook request timeout in milliseconds
WEBHOOK_TIMEOUT=30000

# API version identifier
API_VERSION=v1

# Maximum requests per university (rate limiting)
MAX_REQUESTS_PER_UNIVERSITY=1000