{
  "name": "norwegian-exam-accommodation-ai",
  "version": "1.0.0",
  "description": "AI-powered system to analyze medical documentation and recommend exam accommodations for Norwegian university students",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "verify-env": "node verify-env.js",
    "test-api": "node test-api.js",
    "test": "node --test \"tests/**/*.js\"",
    "test:integration": "node --test \"tests/integration/**/*.js\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bullmq": "^5.66.0",
    "clamscan": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.3",
    "pdf2json": "^4.0.0",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "tesseract.js": "^5.1.0",
    "tmp": "^0.2.3",
    "winston": "^3.19.0"
  }
}
